      "texto": "Despreciando a los demás del camerino",
      "tiempo_fin": 26000
    },
    {
      "tiempo": 26000,
      "texto": "Pero la supuesta diva por el eco de una vida",
      "tiempo_fin": 30000
    },
    {
      "tiempo": 30000,
      "texto": "Que no le pertenecía, se embrujó",
      "tiempo_fin": 35000
    },
    {
      "tiempo": 35000,
      "texto": "Una diva es sencilla como un simple mortal",
      "tiempo_fin": 41000
    },
    {
      "tiempo": 41000,
      "texto": "Una diva no pisa a nadie para brillar",
      "tiempo_fin": 44000
    },
    {
      "tiempo": 44000,
      "texto": "Su voz le hace grande, ¿qué más da",
      "tiempo_fin": 48000
    },
    {
      "tiempo": 48000,
      "texto": "Si ella es libre cantando como un pez en el mar?",
      "tiempo_fin": 52000
    },
    {
      "tiempo": 52000,
      "texto": "Una diva es valiente, poderosa",
      "tiempo_fin": 56000
    },
    {
      "tiempo": 56000,
      "texto": "Su vida es un jardín lleno de espinas y rosas",
      "tiempo_fin": 60000
