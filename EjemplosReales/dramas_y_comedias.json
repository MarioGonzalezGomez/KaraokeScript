      "tiempo_fin": 86000
    },
    {
      "tiempo": 86000,
      "texto": "Llantos y tragedias, no",
      "tiempo_fin": 91000
    },
    {
      "tiempo": 91000,
      "texto": "¿Qué más da?",
      "tiempo_fin": 93000
    },
    {
      "tiempo": 93000,
      "texto": "Si todo es mentira",
      "tiempo_fin": 95000
    },
    {
      "tiempo": 95000,
      "texto": "¿Qué más da?",
      "tiempo_fin": 96000
    },
    {
      "tiempo": 96000,
      "texto": "Deja que me ría",
      "tiempo_fin": 98000
    },
    {
      "tiempo": 98000,
      "texto": "¿Qué más da?",
      "tiempo_fin": 99000
    },
    {
      "tiempo": 99000,
      "texto": "Si al final el día",
      "tiempo_fin": 102000
    },
    {
      "tiempo": 102000,
      "texto": "¿Qué más da?",
      "tiempo_fin": 103000
    },
    {
      "tiempo": 103000,
      "texto": "Va a acabar, igual",
      "tiempo_fin": 108000
    },
    {
      "tiempo": 113000,
      "texto": "Deja de quejarte sin descanso",
      "tiempo_fin": 117000
    },
    {
      "tiempo": 117000,
      "texto": "Es aburrido",
      "tiempo_fin": 120000
    },
    {
      "tiempo": 120000,
      "texto": "Y, ¿de qué sirve?",
      "tiempo_fin": 124000
    },
    {
      "tiempo": 124000,
      "texto": "Piensa que el futuro sigue en blanco",
      "tiempo_fin": 131000
    },
    {
      "tiempo": 131000,
      "texto": "Que nada está escrito",
      "tiempo_fin": 134000
    },
    {
      "tiempo": 134000,
      "texto": "Que todo es posible",
      "tiempo_fin": 138000
    },
    {
      "tiempo": 138000,
      "texto": "He conseguido borrar de un plumazo las fobias y manías",
      "tiempo_fin": 146000
    },
    {
      "tiempo": 146000,
      "texto": "Ha sido fácil",
      "tiempo_fin": 148000
