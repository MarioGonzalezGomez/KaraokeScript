  "duracion": 0,
  "lineas": [
    {
      "tiempo": 18000,
      "texto": "Si la ves pregúntale",
      "tiempo_fin": 20000
    },
    {
      "tiempo": 20000,
      "texto": "que siente,",
      "tiempo_fin": 23000
    },
    {
      "tiempo": 23000,
      "texto": "si aún le queda algo",
      "tiempo_fin": 24000
    },
    {
      "tiempo": 24000,
      "texto": "de ese amor que nos unió.",
      "tiempo_fin": 27000
    },
    {
      "tiempo": 27000,
      "texto": "Si la encuentras",
      "tiempo_fin": 29000
    },
    {
      "tiempo": 29000,
      "texto": "algo indiferente,",
      "tiempo_fin": 31000
    },
    {
      "tiempo": 31000,
      "texto": "éntrala en razón",
      "tiempo_fin": 33000
    },
    {
      "tiempo": 33000,
      "texto": "y hazme este favor.",
      "tiempo_fin": 36000
    },
    {
      "tiempo": 36000,
      "texto": "Háblale, insístele",
      "tiempo_fin": 40000
    },
    {
      "tiempo": 40000,
      "texto": "que nos han hecho daño,",
      "tiempo_fin": 43000
    },
    {
      "tiempo": 43000,
      "texto": "que todo es mentira.",
      "tiempo_fin": 46000
    },
    {
      "tiempo": 46000,
      "texto": "Dile que la quiero,",
      "tiempo_fin": 48000
    },
    {
      "tiempo": 48000,
      "texto": "que siempre fui sincero,",
      "tiempo_fin": 50000
    },
    {
      "tiempo": 50000,
      "texto": "dile que me estoy volviendo",
      "tiempo_fin": 52000
    },
    {
      "tiempo": 52000,
      "texto": "loco por una tontería",
      "tiempo_fin": 55000
    },
    {
      "tiempo": 55000,
      "texto": "Dile que navego",
      "tiempo_fin": 57000
    },
    {
      "tiempo": 57000,
      "texto": "entre el amor y el miedo,",
      "tiempo_fin": 59000
    },
    {
      "tiempo": 59000,
      "texto": "dile que me está matando",
      "tiempo_fin": 62000
    },
    {
      "tiempo": 62000,
      "texto": "esta melancolía.",
