{
  "id": 14,
  "titulo": "CUANDO ZARPA EL AMOR",
  "artista": "CAMELA",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 22520,
      "texto": "Hace ya algún tiempo que vivo sin ti",
      "tiempo_fin": 26000
    },
    {
      "tiempo": 26000,
      "texto": "Y aún no me acostumbro, ¿por qué voy a mentir?",
      "tiempo_fin": 30000
    },
    {
      "tiempo": 30000,
      "texto": "Juntos acordamos mejor separarnos",
      "tiempo_fin": 34000
    },
    {
      "tiempo": 34000,
      "texto": "Hoy sé que no puedo seguir así",
      "tiempo_fin": 40000
    },
    {
      "tiempo": 40000,
      "texto": "Intenté olvidarte y no lo conseguí",
      "tiempo_fin": 44000
    },
    {
      "tiempo": 44000,
      "texto": "Lleno de recuerdos, todos hablan de ti",
      "tiempo_fin": 48000
    },
    {
      "tiempo": 48000,
      "texto": "La casa vacía, ni luz ni alegría",
      "tiempo_fin": 52000
    },
    {
      "tiempo": 52000,
      "texto": "Estoy muerto en vida si no estás aquí",
      "tiempo_fin": 58000
    },
    {
      "tiempo": 58000,
      "texto": "Dime que sientes lo mismo que yo",
      "tiempo_fin": 64000
    },
    {
      "tiempo": 64000,
      "texto": "Dime que me quieres, dímelo",
      "tiempo_fin": 69000
    },
    {
      "tiempo": 69000,
      "texto": "Cuando zarpa el amor",
      "tiempo_fin": 71000
    },
    {
      "tiempo": 71000,
      "texto": "Navega a ciegas, es quien lleva el timón",
      "tiempo_fin": 76000
    },
    {
      "tiempo": 76000,
      "texto": "Y cuando sube la marea al corazón",
      "tiempo_fin": 79000
    },
    {
      "tiempo": 79000,
      "texto": "Sabe que el viento sopla a su favor",
      "tiempo_fin": 85000
    },
    {
      "tiempo": 85000,
      "texto": "No podemos hacer nada",
      "tiempo_fin": 87000
    },
    {
      "tiempo": 87000,
      "texto": "Por cambiar el rumbo que marcó",
      "tiempo_fin": 90000
    },
    {
      "tiempo": 90000,
      "texto": "Para los dos",
      "tiempo_fin": 94000
    },
    {
      "tiempo": 94000,
      "texto": "Cuando zarpa el amor",
      "tiempo_fin": 97000
    },
    {
      "tiempo": 107000,
      "texto": "No sabes lo difícil que ha llegado a ser",
      "tiempo_fin": 111000
    },
    {
      "tiempo": 111000,
      "texto": "Estar sin tu cariño sin poderte tener",
      "tiempo_fin": 115000
    },
    {
      "tiempo": 115000,
      "texto": "Cuánto eché de menos, mi niña, tus besos",
      "tiempo_fin": 119000
    },
    {
      "tiempo": 119000,
      "texto": "De ti ya nunca me separaré",
      "tiempo_fin": 125000
    },
    {
      "tiempo": 125000,
      "texto": "Aún llevas la alianza que te regalé",
      "tiempo_fin": 129000
    },
    {
      "tiempo": 129000,
      "texto": "Y en tus ojos brilla la ilusión otra vez",
      "tiempo_fin": 133000
    },
    {
      "tiempo": 133000,
      "texto": "Siento escalofríos cuando estoy contigo",
      "tiempo_fin": 137000
    },
    {
      "tiempo": 137000,
      "texto": "Acerca tus manos y acaríciame",
      "tiempo_fin": 142000
    },
    {
      "tiempo": 142000,
      "texto": "Dime que sientes lo mismo que yo",
      "tiempo_fin": 149000
