{
  "id": 10,
  "titulo": "MI GRAN NOCHE",
  "artista": "RAPHAEL",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "Hoy, para mí, es un día especial"
    },
    {
      "tiempo": 0,
      "texto": "Hoy saldré por la noche"
    },
    {
      "tiempo": 0,
      "texto": "Podré vivir lo que el mundo nos da"
    },
    {
      "tiempo": 0,
      "texto": "Cuando el Sol ya se esconde"
    },
    {
      "tiempo": 0,
      "texto": "Podré cantar una dulce canción"
    },
    {
      "tiempo": 0,
      "texto": "A la luz de la Luna"
    },
    {
      "tiempo": 0,
      "texto": "Y acariciar y besar a mi amor"
    },
    {
      "tiempo": 0,
      "texto": "Como no lo hice nunca"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué pasará? ¿Qué misterio habrá?"
    },
    {
      "tiempo": 0,
      "texto": "Puede ser mi gran noche"
    },
    {
      "tiempo": 0,
      "texto": "Y al despertar, ya mi vida sabrá"
    },
    {
      "tiempo": 0,
      "texto": "Algo que no conoce"
    },
    {
      "tiempo": 0,
      "texto": "Caminaré, abrazado a mi amor"
    },
    {
      "tiempo": 0,
      "texto": "Por las calles sin rumbo"
    },
    {
      "tiempo": 0,
      "texto": "Descubriré que el amor es mejor"
    },
    {
      "tiempo": 0,
      "texto": "Cuando todo está oscuro"
    },
    {
      "tiempo": 0,
      "texto": "Y sin hablar, nuestros pasos se irán"
    },
    {
      "tiempo": 0,
      "texto": "A buscar otra puerta"
    },
    {
      "tiempo": 0,
      "texto": "Que se abrirá como mi corazón"
    },
    {
      "tiempo": 0,
      "texto": "Cuando ella se acerca"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué pasará? ¿Qué misterio habrá?"
    },
    {
      "tiempo": 0,
      "texto": "Puede ser mi gran noche"
    },
    {
      "tiempo": 0,
      "texto": "Y al despertar, ya mi vida sabrá"
    },
    {
      "tiempo": 0,
      "texto": "Algo que no conoce"
    },
    {
      "tiempo": 0,
      "texto": "Será, será esta noche ideal"
    },
    {
      "tiempo": 0,
      "texto": "Que ya nunca se olvida"
    },
    {
      "tiempo": 0,
      "texto": "Podré reír y soñar y bailar"
    },
    {
      "tiempo": 0,
      "texto": "Disfrutando la vida"
    },
    {
      "tiempo": 0,
      "texto": "Olvidaré la tristeza y el mal"
    },
    {
      "tiempo": 0,
      "texto": "Y las penas del mundo"
    },
    {
      "tiempo": 0,
      "texto": "Y escucharé los violines cantar"
    },
    {
      "tiempo": 0,
      "texto": "En la noche, sin rumbo"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué pasará? ¿Qué misterio habrá?"
    },
    {
      "tiempo": 0,
      "texto": "Puede ser mi gran noche"
    },
    {
      "tiempo": 0,
      "texto": "Y al despertar, ya mi vida sabrá"
    },
    {
      "tiempo": 0,
      "texto": "Algo que no conoce"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué pasará? ¿Qué misterio habrá?"
    },
    {
      "tiempo": 0,
      "texto": "Puede ser mi gran noche"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué pasará? ¿Qué misterio habrá?"
    },
    {
      "tiempo": 0,
      "texto": "Puede ser mi gran noche"
    }
