{
  "id": 5,
  "titulo": "A QUIEN LE IMPORTA",
  "artista": "ALASKA",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "La gente me señala"
    },
    {
      "tiempo": 0,
      "texto": "Me apuntan con el dedo"
    },
    {
      "tiempo": 0,
      "texto": "Susurra a mis espaldas"
    },
    {
      "tiempo": 0,
      "texto": "Y a mí me importa un bledo"
    },
    {
      "tiempo": 0,
      "texto": "Que más me da"
    },
    {
      "tiempo": 0,
      "texto": "Si soy distinta a ellos"
    },
    {
      "tiempo": 0,
      "texto": "No soy de nadie"
    },
    {
      "tiempo": 0,
      "texto": "No tengo dueño"
    },
    {
      "tiempo": 0,
      "texto": "Yo sé que me critican"
    },
    {
      "tiempo": 0,
      "texto": "Me consta que me odian"
    },
    {
      "tiempo": 0,
      "texto": "La envidia les corroe"
    },
    {
      "tiempo": 0,
      "texto": "Mi vida les agobia"
    },
    {
      "tiempo": 0,
      "texto": "¿Por qué será?"
    },
    {
      "tiempo": 0,
      "texto": "Yo no tengo la culpa"
    },
    {
      "tiempo": 0,
      "texto": "Mi circunstancia les insulta"
    },
    {
      "tiempo": 0,
      "texto": "Mi destino es el que yo decido"
    },
    {
      "tiempo": 0,
      "texto": "El que yo elijo para mi"
    },
    {
      "tiempo": 0,
      "texto": "¿A quién le importa lo que yo haga?"
    },
    {
      "tiempo": 0,
      "texto": "¿A quién le importa lo que yo diga?"
    },
    {
      "tiempo": 0,
      "texto": "Yo soy así, y así seguiré, nunca cambiaré"
    },
    {
      "tiempo": 0,
      "texto": "¿A quién le importa lo que yo haga?"
    },
    {
      "tiempo": 0,
      "texto": "¿A quién le importa lo que yo diga?"
    },
    {
      "tiempo": 0,
      "texto": "Yo soy así, y así seguiré, nunca cambiaré"
    },
    {
      "tiempo": 0,
      "texto": "Quizá la culpa es mía"
    },
    {
      "tiempo": 0,
      "texto": "Por no seguir la norma"
    },
    {
      "tiempo": 0,
      "texto": "Ya es demasiado tarde"
    },
    {
      "tiempo": 0,
      "texto": "Para cambiar ahora"
    },
    {
      "tiempo": 0,
      "texto": "Me mantendré"
    },
    {
      "tiempo": 0,
      "texto": "Firme en mis convicciones"
    },
    {
      "tiempo": 0,
      "texto": "Reforzaré mis posiciones"
    },
    {
      "tiempo": 0,
      "texto": "Mi destino es el que yo decido"
    },
    {
      "tiempo": 0,
      "texto": "El que yo elijo para mi"
    },
    {
      "tiempo": 0,
