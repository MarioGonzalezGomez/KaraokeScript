  "titulo": "DILE QUE LA QUIERO",
  "artista": "DAVID CIVERA",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "Si la ves pregúntale"
    },
    {
      "tiempo": 0,
      "texto": "que siente,"
    },
    {
      "tiempo": 0,
      "texto": "si aún le queda algo"
    },
    {
      "tiempo": 0,
      "texto": "de ese amor que nos unió."
    },
    {
      "tiempo": 0,
      "texto": "Si la encuentras"
    },
    {
      "tiempo": 0,
      "texto": "algo indiferente,"
    },
    {
      "tiempo": 0,
      "texto": "éntrala en razón"
    },
    {
      "tiempo": 0,
      "texto": "y hazme este favor."
    },
    {
      "tiempo": 0,
      "texto": "Háblale, insístele"
    },
    {
      "tiempo": 0,
      "texto": "que nos han hecho daño,"
    },
    {
      "tiempo": 0,
      "texto": "que todo es mentira."
    },
    {
      "tiempo": 0,
      "texto": "Dile que la quiero,"
    },
    {
      "tiempo": 0,
      "texto": "que siempre fui sincero,"
    },
    {
      "tiempo": 0,
      "texto": "dile que me estoy volviendo"
    },
    {
      "tiempo": 0,
      "texto": "loco por una tontería"
    },
    {
      "tiempo": 0,
      "texto": "Dile que navego"
    },
    {
      "tiempo": 0,
      "texto": "entre el amor y el miedo,"
    },
    {
      "tiempo": 0,
      "texto": "dile que me está matando"
    },
    {
      "tiempo": 0,
      "texto": "esta melancolía."
    },
    {
      "tiempo": 0,
      "texto": "Dile, que la quiero"
    },
