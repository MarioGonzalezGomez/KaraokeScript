  "titulo": "VIVIR ASÍ ES MORIR DE AMOR",
  "artista": "CAMILO SEXTO",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "Siempre me traiciona la razón"
    },
    {
      "tiempo": 0,
      "texto": "Y me domina el corazón"
    },
    {
      "tiempo": 0,
      "texto": "No sé luchar contra el amor"
    },
    {
      "tiempo": 0,
      "texto": "Siempre me voy a enamorar"
    },
    {
      "tiempo": 0,
      "texto": "De quien de mí no se enamora"
    },
    {
      "tiempo": 0,
      "texto": "Y es por eso que mi alma llora"
    },
    {
      "tiempo": 0,
      "texto": "¡Y ya no puedo más!"
    },
    {
      "tiempo": 0,
      "texto": "¡Ya no puedo más!"
    },
    {
      "tiempo": 0,
      "texto": "Siempre se repite esta misma historia"
    },
    {
      "tiempo": 0,
      "texto": "¡Ya no puedo más!"
    },
