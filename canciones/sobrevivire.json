{
  "id": 3,
  "titulo": "SOBREVIVIRÉ",
  "artista": "MÓNICA NARANJO",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "Tengo el ansia de dar juventud"
    },
    {
      "tiempo": 0,
      "texto": "Tengo miedo, lo mismo que tú"
    },
    {
      "tiempo": 0,
      "texto": "Y cada amanecer me derrumbo al ver"
    },
    {
      "tiempo": 0,
      "texto": "La puta realidad"
    },
    {
      "tiempo": 0,
      "texto": "No hay en el mundo, no"
    },
    {
      "tiempo": 0,
      "texto": "Nadie más frágil que yo"
    },
    {
      "tiempo": 0,
      "texto": "Pelo acrílico, cuero y tacón"
    },
    {
      "tiempo": 0,
      "texto": "Maquillaje hasta en el corazón"
    },
    {
      "tiempo": 0,
      "texto": "Y al anochecer vuelve a florecer"
    },
    {
      "tiempo": 0,
      "texto": "Lubrica la ciudad"
    },
    {
      "tiempo": 0,
      "texto": "No hay en el mundo, no"
    },
    {
      "tiempo": 0,
      "texto": "Nadie más dura que yo"
    },
    {
      "tiempo": 0,
      "texto": "Debo sobrevivir"
    },
    {
      "tiempo": 0,
      "texto": "Mintiéndome"
    },
    {
      "tiempo": 0,
      "texto": "Taciturna me hundí en aquel bar"
    },
    {
      "tiempo": 0,
      "texto": "Donde un ángel me dijo al entrar"
    },
    {
      "tiempo": 0,
      "texto": "Ven y elévate como el humo azul"
    },
    {
      "tiempo": 0,
      "texto": "No sufras más, amor"
    },
    {
      "tiempo": 0,
      "texto": "Y desgarrándome, algo en mi vida cambió"
    },
    {
      "tiempo": 0,
      "texto": "Sobreviviré"
    },
    {
      "tiempo": 0,
      "texto": "Buscaré un hogar"
    },
    {
      "tiempo": 0,
      "texto": "Entre los escombros"
    },
    {
      "tiempo": 0,
      "texto": "De mi soledad"
    },
    {
      "tiempo": 0,
      "texto": "Paraíso extraño"
    },
    {
      "tiempo": 0,
      "texto": "Donde no estás tú"
    },
    {
      "tiempo": 0,
      "texto": "Y aunque duela quiero libertad"
    },
    {
      "tiempo": 0,
      "texto": "Aunque me haga daño"
    },
    {
      "tiempo": 0,
      "texto": "Uh-eh-he-he-he"
    },
    {
      "tiempo": 0,
      "texto": "He-eh-eh-eh-he"
    },
