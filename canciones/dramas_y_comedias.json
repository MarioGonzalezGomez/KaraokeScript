{
  "id": 16,
  "titulo": "DRAMAS Y COMEDIAS",
  "artista": "ALASKA",
  "duracion": 0,
  "lineas": [
    {
      "tiempo": 0,
      "texto": "No quiero más dramas en mi vida"
    },
    {
      "tiempo": 0,
      "texto": "Sólo comedias entretenidas"
    },
    {
      "tiempo": 0,
      "texto": "Así que no me vengas con historias de celos"
    },
    {
      "tiempo": 0,
      "texto": "Llantos y tragedias, no"
    },
    {
      "tiempo": 0,
      "texto": "Si me llamas para lo de siempre"
    },
    {
      "tiempo": 0,
      "texto": "No te molestes"
    },
    {
      "tiempo": 0,
      "texto": "No me interesa ya"
    },
    {
      "tiempo": 0,
      "texto": "Lo repito, por si no lo entiendes"
    },
    {
      "tiempo": 0,
      "texto": "Me cansa estar triste"
    },
    {
      "tiempo": 0,
      "texto": "Y no me compensa más"
    },
    {
      "tiempo": 0,
      "texto": "He decidido enterrar el dolor y la pena"
    },
    {
      "tiempo": 0,
      "texto": "Voy a olvidarme de los problemas"
    },
    {
      "tiempo": 0,
      "texto": "No quiero más dramas en mi vida"
    },
    {
      "tiempo": 0,
      "texto": "Sólo comedias entretenidas"
    },
    {
      "tiempo": 0,
      "texto": "Así que no me vengas con historias de celos"
    },
    {
      "tiempo": 0,
      "texto": "Llantos y tragedias, no"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué más da?"
    },
    {
      "tiempo": 0,
      "texto": "Si todo es mentira"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué más da?"
    },
    {
      "tiempo": 0,
      "texto": "Deja que me ría"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué más da?"
    },
    {
      "tiempo": 0,
      "texto": "Si al final el día"
    },
    {
      "tiempo": 0,
      "texto": "¿Qué más da?"
    },
    {
      "tiempo": 0,
      "texto": "Va a acabar, igual"
    },
    {
      "tiempo": 0,
      "texto": "Deja de quejarte sin descanso"
    },
    {
      "tiempo": 0,
      "texto": "Es aburrido"
    },
    {
      "tiempo": 0,
      "texto": "Y, ¿de qué sirve?"
    },
    {
      "tiempo": 0,
      "texto": "Piensa que el futuro sigue en blanco"
    },
    {
      "tiempo": 0,
      "texto": "Que nada está escrito"
    },
    {
      "tiempo": 0,
      "texto": "Que todo es posible"
    },
    {
      "tiempo": 0,
      "texto": "He conseguido borrar de un plumazo las fobias y manías"
    },
    {
      "tiempo": 0,
      "texto": "Ha sido fácil"
    },
    {
      "tiempo": 0,
      "texto": "Son tonterías"
    },
